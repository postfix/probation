      "id": "service-marker-before-delete",
      "operation": "consume_service_marker_then_send",
      "flow": "service-scoped-version-unpublish",
      "claim": "The accepted-removal marker, bound to the service-store reference and resulting revision, must be atomically consumed before outbound DELETE. This analyzer checks call order only; transaction atomicity, revision binding, concurrent one-winner behavior, replay refusal and credential destination are runtime/source-review obligations.",
      "source": "src/http/service_unpublish.rs",
      "symbol": "consume_service_marker_then_send",
      "spec": "docs/plans/publishing-proxy/specs/service-unpublish-marker-before-delete.yaml",
