    {
      "id": "service-removal-marker-after-put",
      "operation": "record_successful_service_removal",
      "flow": "service-scoped-version-unpublish",
      "claim": "A durable service-scoped revision marker is committed only after the selected upstream accepted the revision PUT and the exact leased version removal is confirmed, using the PUT response revision or an immediate authenticated selected-upstream GET when omitted. The ordered spec checks resolver-before-commit call order only; exact revision/value binding, GET behavior, durability and failure recovery require Slice 3 runtime/source review.",
      "source": "src/http/service_unpublish.rs",
      "symbol": "record_successful_service_removal",
      "spec": "docs/plans/publishing-proxy/specs/service-removal-marker-after-put.yaml",
      "bySlice": 3,
      "controls": [
        {
          "id": "commit-without-confirmed-removal",
          "mutations": [
            {
              "source": "src/http/service_unpublish.rs",
              "from": "let revision = resolve_removed_revision_from_put_or_authenticated_get(&response, &reference).await?;",
              "to": "let revision = unchecked_removal_revision(&response, &reference).await?;"
            }
          ],
          "expect": {
            "file": "src/http/service_unpublish.rs",
            "summaryIncludes": "Operation 'commit_service_removal_marker' lacks required guard"
