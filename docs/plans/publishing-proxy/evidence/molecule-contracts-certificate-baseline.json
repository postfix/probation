{
  "version": 1,
  "contracts": [
    {
      "id": "classify-before-dispatch",
      "operation": "classify_registry_request",
      "flow": "unknown-route",
      "claim": "Selected registry ID validation precedes npm package read dispatch; route-table completeness and denial require client and wrong-route controls.",
      "source": "src/http/registry_routes.rs",
      "symbol": "package",
      "spec": "docs/plans/publishing-proxy/specs/classify-before-dispatch.yaml",
      "bySlice": 1,
      "controls": [
        {
          "id": "missing-classification",
          "mutations": [
            {
              "source": "src/http/registry_routes.rs",
              "from": "Path((registry, package)): Path<(String, String)>,\n) -> Result<Response, ApiError> {\n    let registry = registry_read::registry_id(&registry)?;",
              "to": "Path((registry, package)): Path<(String, String)>,\n) -> Result<Response, ApiError> {\n    let registry = registry_read::unchecked_registry_id(&registry)?;"
            }
          ],
          "expect": {
            "file": "src/http/registry_routes.rs",
            "summaryIncludes": "Operation 'serve_registry' lacks required guard"
          }
        }
      ]
    },
    {
      "id": "tls-peer-before-admit",
      "operation": "admit_certificate",
      "flow": "install",
      "claim": "The package admission path requires a verified-peer option before certificate admission; TLS provenance, HTTP header forgery and same-peer routing require runtime controls.",
      "source": "src/http/registry_read.rs",
      "symbol": "admit",
      "spec": "docs/plans/publishing-proxy/specs/tls-peer-before-admit.yaml",
      "bySlice": 1,
      "controls": [
        {
          "id": "header-peer-bypass",
          "mutations": [
            {
              "source": "src/http/registry_read.rs",
              "from": "let peer = peer.ok_or_else(|| ApiError::Unauthenticated)?;",
              "to": "let peer = peer.unwrap();"
            }
          ],
          "expect": {
            "file": "src/http/registry_read.rs",
            "summaryIncludes": "Operation 'Managed.admit_certificate' lacks required guard"
          }
        }
      ]
    },
    {
      "id": "current-certificate-before-grant",
      "operation": "admit_certificate",
      "flow": "install",
      "claim": "A per-request management certificate lookup precedes policy resolution for a registry principal; exact chain, serial, revocation and fail-closed behavior require runtime controls.",
      "source": "src/managed/mod.rs",
      "symbol": "Managed.admit_certificate",
      "spec": "docs/plans/publishing-proxy/specs/current-certificate-before-grant.yaml",
      "bySlice": 1,
      "controls": [
        {
          "id": "stale-certificate-lookup",
          "mutations": [
            {
              "source": "src/managed/mod.rs",
              "from": ".certificate(CertificateAdmissionRequest {",
              "to": ".cached_certificate(CertificateAdmissionRequest {"
            }
          ],
          "expect": {
            "file": "src/managed/mod.rs",
            "summaryIncludes": "Operation 'resolve' lacks required guard"
          }
        }
      ]
    },
    {
      "id": "live-status-before-grant",
      "operation": "admit_certificate",
      "flow": "install",
      "claim": "A live status check precedes organization-issued grant. Issuer-authorized signature, exact issuer+serial, fresh nonce, committed-revocation visibility and fail-closed outage need wrong-value and real-issuer runtime controls.",
      "source": "src/managed/enterprise_certificate.rs",
      "symbol": "resolve_enterprise_certificate",
      "spec": "docs/plans/publishing-proxy/specs/live-status-before-grant.yaml",
      "bySlice": 2,
      "controls": [
        {
          "id": "cached-good-status",
          "mutations": [
            {
              "source": "src/managed/enterprise_certificate.rs",
              "from": "let status = check_live_issuer_status(peer).await?;",
              "to": "let status = cached_issuer_status(peer).await?;"
            }
          ],
          "expect": {
            "file": "src/managed/enterprise_certificate.rs",
            "summaryIncludes": "Operation 'grant_enterprise_certificate' lacks required guard"
          }
        }
      ]
    },
    {
      "id": "policy-before-package-send",
      "operation": "serve_package_read",
      "flow": "install",
      "claim": "Package resolution precedes npm metadata rendering; exact policy decisions, artifact bytes, current group and all-route coverage require runtime controls.",
      "source": "src/npm/mod.rs",
      "symbol": "serve_with_url",
      "spec": "docs/plans/publishing-proxy/specs/package-policy-before-send.yaml",
      "bySlice": 1,
      "controls": [
        {
          "id": "unchecked-package-read",
          "mutations": [
            {
              "source": "src/npm/mod.rs",
              "from": "let resolved = resolve(app, name, &policy, snapshot, now, monotonic, registry_id, principal.and_then(|p| p.registry_origin.as_ref()), principal.map_or(&[][..], |p| p.registry_private_cidrs.as_slice()), principal.and_then(|p| p.registry_read_authorization.as_deref())).await?;",
              "to": "let resolved = unchecked_resolve(app, name, &policy, snapshot, now, monotonic, registry_id, principal.and_then(|p| p.registry_origin.as_ref()), principal.map_or(&[][..], |p| p.registry_private_cidrs.as_slice()), principal.and_then(|p| p.registry_read_authorization.as_deref())).await?;"
            }
          ],
          "expect": {
            "file": "src/npm/mod.rs",
            "summaryIncludes": "Operation 'render' lacks required guard"
          }
        }
      ]
    },
    {
