   "source": "crates/probation-server/src/tenancy.rs",
   "symbol": "authorize",
   "spec": ".smtc/analyzers/managed-authorize-may-edit-first.yaml",
   "bySlice": 4,
   "controls": [
    {
     "id": "permission-check-removed",
     "mutations": [
      {
       "source": "crates/probation-server/src/tenancy.rs",
       "from": "    if !role.may_edit(checked.layer_kind()) {\n        return Err(Denied);\n    }\n",
       "to": ""
      }
     ],
     "expect": {
      "file": "crates/probation-server/src/tenancy.rs",
      "summaryIncludes": "Operation 'EditPermit.granted' lacks required guard"
     }
    },
    {
     "id": "global-admin-bypass",
     "mutations": [
      {
       "source": "crates/probation-server/src/tenancy.rs",
       "from": "    let role = role_on(actor, checked.place()).ok_or(Denied)?;",
