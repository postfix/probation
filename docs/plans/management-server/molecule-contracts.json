  {
   "id": "apply-changes-keys-before-cursor",
   "operation": "apply_changes",
   "flow": "sync-changes",
   "claim": "In KeySync::apply_changes, cache.remove_keys is called before advance_cursor: the sync cursor moves past a delta only after the delta's changed keys were removed.",
   "source": "src/managed/sync.rs",
   "symbol": "KeySync.apply_changes",
   "spec": ".smtc/analyzers/managed-apply-changes-keys-before-cursor.yaml",
   "bySlice": 3,
   "controls": [
    {
     "id": "keys-not-expired",
     "mutations": [
      {
       "source": "src/managed/sync.rs",
       "from": "        self.cache.remove_keys(&delta.changed_keys, delta.revision);\n",
       "to": ""
      }
     ],
     "expect": {
      "file": "src/managed/sync.rs",
      "summaryIncludes": "Operation 'KeySync.advance_cursor' lacks required guard"
     }
    },
    {
     "id": "cursor-first",
     "mutations": [
      {
       "source": "src/managed/sync.rs",
       "from": "        self.cache.remove_keys(&delta.changed_keys, delta.revision);\n        self.cache.expire_places(&delta.changed_places, delta.revision);\n        self.advance_cursor(delta.revision);",
       "to": "        self.advance_cursor(delta.revision);\n        self.cache.remove_keys(&delta.changed_keys, delta.revision);\n        self.cache.expire_places(&delta.changed_places, delta.revision);"
      }
     ],
     "expect": {
      "file": "src/managed/sync.rs",
      "summaryIncludes": "Operation 'KeySync.advance_cursor' lacks required guard"
     }
    }
   ]
