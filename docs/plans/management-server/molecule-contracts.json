    {
     "id": "change-after-commit",
     "mutations": [
      {
       "source": "crates/probation-server/src/policy.rs",
       "from": "        let () = insert_change(&mut tx, checked.place(), revision).await?;\n        let () = insert_audit(&mut tx, actor, &permit, &checked).await?;\n        let () = tx.commit().await?;",
       "to": "        let () = insert_audit(&mut tx, actor, &permit, &checked).await?;\n        let () = tx.commit().await?;\n        let () = insert_change(&mut self.pool.acquire().await?, checked.place(), revision).await?;"
