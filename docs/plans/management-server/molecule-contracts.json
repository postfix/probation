     "mutations": [
      {
       "source": "src/managed/sync.rs",
       "from": "        self.cache.expire_places(&delta.changed_places, delta.revision);\n        self.advance_cursor(delta.revision);",
       "to": "        self.advance_cursor(delta.revision);\n        self.cache.expire_places(&delta.changed_places, delta.revision);"
      }
     ],
     "expect": {
      "file": "src/managed/sync.rs",
      "summaryIncludes": "Operation 'KeySync.advance_cursor' lacks required guard"
     }
    }
   ]
  }
